# Normalize line endings on commit.
* text=auto eol=lf

# Binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mo binary
*.zip binary

# Files to exclude from `git archive` / WP.org plugin zip.
.editorconfig         export-ignore
.gitattributes        export-ignore
.gitignore            export-ignore
.phpcs.xml.dist       export-ignore
phpunit.xml.dist      export-ignore
eslint.config.mjs     export-ignore
build.mjs             export-ignore
package.json          export-ignore
package-lock.json     export-ignore
node_modules/         export-ignore
tests/                export-ignore
languages/README.md   export-ignore

# Language stats (linguist hints for GitHub).
*.php linguist-language=PHP
*.js linguist-language=JavaScript
