msgid "Højst %d stier, én pr. linje (kun stier, ingen fulde URL'er). Forsiden scannes altid, og resten udfyldes automatisk op til 5 sider."
msgstr "At most %d paths, one per line (paths only, no full URLs). The front page is always scanned, and the rest is filled in automatically up to 5 pages."

#: templates/partials/admin-blocker.php:430
msgid "Bloker ukendt inline-script"
msgstr "Block unknown inline script"

#: templates/partials/admin-blocker.php:440
msgid "En unik tekst fra scriptets kode (8-64 tegn: bogstaver, tal, punktum, bindestreg og understreg). Inline-scripts, der indeholder teksten, blokeres indtil samtykke."
msgstr "A unique text from the script's code (8-64 characters: letters, digits, dots, hyphens and underscores). Inline scripts containing the text are blocked until consent."

#: templates/partials/admin-blocker.php:448
msgid "Egne vendors"
msgstr "Custom vendors"

#: templates/partials/admin-blocker.php:449
msgid "Til fund, der ikke er i kataloget. De kan vælges i Vendor-kolonnen og kommer med i cookie-deklarationen. Tøm navnet for at fjerne en vendor."
msgstr "For detections that are not in the catalogue. They can be chosen in the Vendor column and are included in the cookie declaration. Clear the name to remove a vendor."

#: templates/partials/admin-blocker.php:496
msgid "Gem blokering"
msgstr "Save blocking"

#: templates/settings-page.php:60
msgid "Blokering"
msgstr "Blocking"

#: templates/settings-page.php:653
msgid "Overtag Meta-sporing"
msgstr "Take over Meta tracking"

#: templates/settings-page.php:662
msgid "TrackWP overtager Meta-sporing (også når GTM er aktiv)."
msgstr "TrackWP takes over Meta tracking (also when GTM is active)."

#: templates/settings-page.php:665
msgid "TrackWP indlæser Meta Pixel og sender Conversions API med samme event_id, også når Google Tag Manager er slået til. Når Pixel ID, access token og klient-side Pixel er udfyldt, slås Pixel og CAPI i Meta for WooCommerce fra, så der ikke tælles dobbelt. Katalogsync kører fortsat. Slet Meta-tags i GTM (pause er ikke nok)."
msgstr "TrackWP loads the Meta Pixel and sends the Conversions API with the same event_id, also when Google Tag Manager is on. When Pixel ID, access token and client-side Pixel are set, Pixel and CAPI in Meta for WooCommerce are turned off so nothing is counted twice. Catalogue sync keeps running. Delete Meta tags in GTM (pausing is not enough)."

#: templates/settings-page.php:673
msgid "TrackWP leverer Meta. Pixel og CAPI i Meta for WooCommerce er slået fra. Katalogsync kører fortsat."
msgstr "TrackWP delivers Meta. Pixel and CAPI in Meta for WooCommerce are turned off. Catalogue sync keeps running."

#: templates/settings-page.php:679
msgid "TrackWP leverer Meta."
msgstr "TrackWP delivers Meta."

