<?xml version="1.0"?>
<ruleset name="TrackWP">
    <description>WordPress Coding Standards for TrackWP plugin.</description>

    <file>.</file>

    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/languages/*</exclude-pattern>
    <exclude-pattern>*/assets/**/*.min.*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="parallel" value="8"/>

    <!-- WordPress-Extra (includes WordPress-Core + best practices) -->
    <rule ref="WordPress-Extra">
        <!-- Codebase uses 4-space indent, not tabs. -->
        <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
        <exclude name="WordPress.WhiteSpace.PrecisionAlignment"/>
        <!-- Codebase uses both array() and [] depending on file age. -->
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
    </rule>

    <!-- PHP 7.4+ compatibility check -->
    <config name="testVersion" value="7.4-"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- Text domain check for i18n -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="trackwp"/>
            </property>
        </properties>
    </rule>
</ruleset>
