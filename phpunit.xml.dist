<?xml version="1.0"?>
<phpunit
    bootstrap="tests/bootstrap.php"
    backupGlobals="false"
    colors="true"
    convertErrorsToExceptions="true"
    convertNoticesToExceptions="true"
    convertWarningsToExceptions="true">
    <testsuites>
        <testsuite name="TrackWP Unit Tests">
            <!-- Only tests/test-*.php. Generators (tests/fixtures), Docker
                 files, e2e/JS specs and legacy snapshots are not test cases
                 and must never be included by PHPUnit. -->
            <directory prefix="test-" suffix=".php">./tests/</directory>
            <exclude>./tests/bootstrap.php</exclude>
            <exclude>./tests/fixtures</exclude>
            <exclude>./tests/docker</exclude>
            <exclude>./tests/e2e</exclude>
            <exclude>./tests/js</exclude>
            <exclude>./tests/legacy</exclude>
        </testsuite>
    </testsuites>
    <php>
        <const name="WP_TESTS_DOMAIN" value="example.org"/>
        <const name="WP_TESTS_EMAIL" value="admin@example.org"/>
        <const name="WP_TESTS_TITLE" value="TrackWP Test Site"/>
    </php>
</phpunit>
